@using BooksApi.Enums
@using BooksApi.Models
@model UserModel

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-dark" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-dark" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<nav>
    <div class="nav nav-tabs" id="nav-tab" role="tablist">
        <button class="nav-link active" id="nav-general-tab" data-bs-toggle="tab" data-bs-target="#nav-general" type="button" role="tab" aria-selected="true" aria-controls="nav-general">
            General Info
        </button>
        <button class="nav-link" id="nav-address-tab" data-bs-toggle="tab" data-bs-target="#nav-address" type="button" role="tab" aria-selected="false" aria-controls="nav-address">
            Address Info
        </button>
    </div>
</nav>

<div class="tab-content" id="nav-tabContent">
    <!-- General -->
    <div class="tab-pane fade show active" id="nav-general" role="tabpanel" aria-labelledby="nav-general-tab">
        <div class="container mt-5">
            <form method="post" asp-action="ToggleUserStatus" asp-controller="User">
                <input type="hidden" asp-for="Id" />

                @if (Model.Profile != ProfileEnum.Client)
                {
                    <h2>Employee Details - @Model.Username</h2>
                }
                else
                {
                    <h2>Client Details - @Model.Username</h2>
                }

                <div class="mb-1">
                    <label>Full Name:</label>
                    <input asp-for="FullName" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Username:</label>
                    <input asp-for="Username" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Email:</label>
                    <input asp-for="Email" type="email" class="form-control shadow-none" disabled />
                </div>

                @if (Model.Profile != ProfileEnum.Client)
                {
                    <div class="mb-1">
                        <label>Profile:</label>
                        <input value="@Model.Profile" type="text" class="form-control shadow-none" disabled />
                    </div>
                }

                <div class="mb-1">
                    <label>Status:</label>
                    <input value="@(Model.IsActive ? "Active" : "Inactive")" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Created At:</label>
                    <input value="@Model.CreatedAt.ToString("dd-MM-yyyy HH:mm")" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Updated At:</label>
                    <input value="@Model.UpdatedAt.ToString("dd-MM-yyyy HH:mm")" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="d-flex mt-3">
                    @if (!Model.IsActive)
                    {
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus"></i> Activate User
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-x"></i> Deactivate User
                        </button>
                    }
                </div>

                @if (Model.Profile == ProfileEnum.Client)
                {
                    <a asp-controller="Client" asp-action="Index" asp-route-id="0" class="btn btn-info w-100 mt-2">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a>
                }
                else
                {
                    <a asp-controller="Employer" asp-action="Index" class="btn btn-info w-100 mt-2">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Address -->
    <div class="tab-pane fade" id="nav-address" role="tabpanel" aria-labelledby="nav-address-tab">
        <div class="container mt-5">
            <form method="post" asp-controller="User" asp-action="ToggleUserStatus">
                <input type="hidden" asp-for="Id" />

                <div class="mb-1">
                    <label>Zip Code:</label>
                    <input asp-for="Address.ZipCode" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Street:</label>
                    <input asp-for="Address.Street" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Number:</label>
                    <input asp-for="Address.Number" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>City:</label>
                    <input asp-for="Address.City" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>State/Region:</label>
                    <input asp-for="Address.State" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="mb-1">
                    <label>Additional Info:</label>
                    <input asp-for="Address.AdditionalInfo" type="text" class="form-control shadow-none" disabled />
                </div>

                <div class="d-flex mt-3">
                    @if (!Model.IsActive)
                    {
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus"></i> Activate User
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-x"></i> Deactivate User
                        </button>
                    }
                </div>

                @if (Model.Profile == ProfileEnum.Client)
                {
                    <a asp-controller="Client" asp-action="Index" asp-route-id="0" class="btn btn-info w-100 mt-2">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a>
                }
                else
                {
                    <a asp-controller="Employer" asp-action="Index" class="btn btn-info w-100 mt-2">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a>
                }
            </form>
        </div>
    </div>
</div>