@using BooksApi.Enums
@using BooksApi.Dto.User
@model UserEditDto

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-dark" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-dark" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container mt-5">
    <form method="post" asp-action="Edit" asp-controller="User">
        <input type="hidden" asp-for="Id" />

        @if (ViewBag.Profile != ProfileEnum.Client)
        {
            <h2>Edit Employee - @Model.Username</h2>
        }
        else
        {
            <h2>Edit Client - @Model.Username</h2>
        }

        <!-- General -->
        <div class="mb-1">
            <label>Full Name:</label>
            <input type="text" asp-for="FullName" class="form-control shadow-none" />
            <span class="text-danger" asp-validation-for="FullName"></span>
        </div>

        <div class="mb-1">
            <label>Username:</label>
            <input type="text" asp-for="Username" class="form-control shadow-none" />
            <span class="text-danger" asp-validation-for="Username"></span>
        </div>

        <div class="mb-1">
            <label>Email:</label>
            <input type="email" asp-for="Email" class="form-control shadow-none" />
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>

        <div class="mb-1">
            <label>Profile:</label>
            <select asp-for="Profile" class="form-control shadow-none">
                <option value="@ProfileEnum.Administrator">Administrator</option>
                <option value="@ProfileEnum.Client">Client</option>
            </select>
            <span class="text-danger" asp-validation-for="Profile"></span>
        </div>

        <!-- Address -->
        <div class="col-12 d-flex gap-1 w-100">
            <div class="mb-1 col-6">
                <label>Zip Code:</label>
                <input type="text" asp-for="Address.ZipCode" class="form-control shadow-none" id="input-zipcode" />
                <span class="text-danger" asp-validation-for="Address.ZipCode"></span>
            </div>

            <div class="mb-1 col-6">
                <label>State/Region:</label>
                <input type="text" asp-for="Address.State" class="form-control shadow-none" id="input-state" />
                <span class="text-danger" asp-validation-for="Address.State"></span>
            </div>
        </div>

        <div class="col-12 d-flex gap-1 w-100">
            <div class="mb-1 col-8">
                <label>Street:</label>
                <input type="text" asp-for="Address.Street" class="form-control shadow-none" id="input-street" />
                <span class="text-danger" asp-validation-for="Address.Street"></span>
            </div>

            <div class="mb-1 col-4">
                <label>Number:</label>
                <input type="text" asp-for="Address.Number" class="form-control shadow-none" />
                <span class="text-danger" asp-validation-for="Address.Number"></span>
            </div>
        </div>

        <div class="col-12 d-flex gap-1 w-100">
            <div class="mb-1 col-6">
                <label>City:</label>
                <input type="text" asp-for="Address.City" class="form-control shadow-none" id="input-city" />
                <span class="text-danger" asp-validation-for="Address.City"></span>
            </div>

            <div class="mb-1 col-6">
                <label>Additional Info:</label>
                <input type="text" asp-for="Address.AdditionalInfo" class="form-control shadow-none" id="input-additional" />
                <span class="text-danger" asp-validation-for="Address.AdditionalInfo"></span>
            </div>
        </div>

        <div class="d-flex mt-3">
            <button type="submit" class="btn btn-success w-50 mx-1">
                <i class="bi bi-save"></i> Save changes
            </button>

            @if (ViewBag.Profile == ProfileEnum.Client)
            {
                <a class="btn btn-info w-50" asp-controller="Client" asp-action="Index" asp-route-id="0">
                    <i class="bi bi-arrow-left-circle"></i> Back
                </a>
            }
            else
            {
                <a class="btn btn-info w-50" asp-controller="Employer" asp-action="Index">
                    <i class="bi bi-arrow-left-circle"></i> Back
                </a>
            }
        </div>
    </form>
</div>

<!-- Vanilla JS postcode lookup (postcodes.io) to populate City/State from ZipCode -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const zip   = document.getElementById('input-zipcode');
    const city  = document.getElementById('input-city');
    const state = document.getElementById('input-state');

    if (!zip || !city || !state) {
      console.warn('Edit.cshtml: missing one or more inputs (#input-zipcode, #input-city, #input-state).');
      return;
    }

    async function lookupPostcode(raw) {
      const normalized = (raw || '').trim().replace(/\s+/g, '').toUpperCase();
      if (!normalized) return;

      try {
        const resp = await fetch(`https://api.postcodes.io/postcodes/${normalized}`);
        const data = await resp.json();
        console.log('postcodes.io response:', data);

        if (data && data.status === 200 && data.result) {
          const r = data.result;
          const cityVal  = r.post_town || r.admin_district || r.admin_ward || '';
          const stateVal = r.region || r.country || '';
          city.value  = cityVal;
          state.value = stateVal;
        } else {
          console.warn('Invalid UK postcode:', raw, data);
        }
      } catch (err) {
        console.error('Error calling postcodes.io:', err);
      }
    }

    zip.addEventListener('blur',   (e) => lookupPostcode(e.target.value));
    zip.addEventListener('change', (e) => lookupPostcode(e.target.value));
  });
</script>