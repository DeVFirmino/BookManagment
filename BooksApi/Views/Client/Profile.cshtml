

@using BooksApi.Models
@model IEnumerable<BorrowModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-dark" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-dark" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <form method="get" asp-action="Profile" asp-controller="Client" class="d-flex justify-content-center align-items-center mt-5" style="height:40px">
                <input name="search" class="form-control mx-2" style="border: 1px solid black; border-radius:10px; width:450px" />
                <div class="form-check">
                    <fieldset>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="filter" id="optionsRadios1" value="NotReturned" checked />
                            <label class="form-check-label" for="optionsRadios1"> Not Returned </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="filter" id="optionsRadios2" value="Returned" />
                            <label class="form-check-label" for="optionsRadios2"> Returned </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="filter" id="optionsRadios3" value="All" />
                            <label class="form-check-label" for="optionsRadios3"> All </label>
                        </div>
                    </fieldset>
                </div>
                <button type="submit" class="btn btn-primary w-10" style="border-radius:10px">Search</button>
            </form>
        </div>

        @if (ViewBag.Filter == "NotReturned")
        {
            <h1 class="text-center mb-3">Books not returned!</h1>
        }

        @if (ViewBag.Filter == "Returned")
        {
            <h1 class="text-center mb-3">Books returned!</h1>
        }

        @if (ViewBag.Filter == "All")
        {
            <h1 class="text-center mb-3">All borrowed books!</h1>
        }

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-0">
            @if (Model.Count() > 0)
            {
                @foreach (var borrow in Model)
                {
                    @if (ViewBag.Filter == "NotReturned")
                    {
                        @if (Model.Where(b => b.ReturnDate == null).ToList().Count() > 0)
                        {
                            @if (borrow.ReturnDate == null)
                            {
                                <div class="card" style="width: 18rem; margin-left: 20px; margin-bottom:20px">
                                    <img src="/image/@borrow.Book.Cover" class="card-img-top" style="width:178px; height:250px" />
                                    <div class="card-body">
                                        <h5 class="card-title">@borrow.Book.Title</h5>
                                        <p class="card-text">@borrow.Book.Author</p>
                                        <p class="card-text">Borrow date: @borrow.BorrowDate</p>
                                        <p class="card-text">Return date: @(borrow.ReturnDate == null ? "Not returned" : borrow.ReturnDate)</p>

                                        @if (borrow.ReturnDate == null)
                                        {
                                            <a class="btn btn-danger w-100" style="font-size: 16px" asp-action="Return" asp-controller="Borrow" asp-route-id="@borrow.Id">Return</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success w-100" style="font-size: 16px">RETURNED</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }

                    @if (ViewBag.Filter == "Returned")
                    {
                        @if (Model.Where(b => b.ReturnDate != null).ToList().Count() > 0)
                        {
                            @if (borrow.ReturnDate != null)
                            {
                                <div class="card" style="width: 18rem; margin-left: 20px; margin-bottom:20px">
                                    <img src="/image/@borrow.Book.Cover" class="card-img-top" style="width:178px; height:250px" />
                                    <div class="card-body">
                                        <h5 class="card-title">@borrow.Book.Title</h5>
                                        <p class="card-text">@borrow.Book.Author</p>
                                        <p class="card-text">Borrow date: @borrow.BorrowDate</p>
                                        <p class="card-text">Return date: @(borrow.ReturnDate == null ? "Not returned" : borrow.ReturnDate)</p>

                                        @if (borrow.ReturnDate == null)
                                        {
                                            <a class="btn btn-danger w-100" style="font-size: 16px" asp-action="Return" asp-controller="Borrow" asp-route-id="@borrow.Id">Return</a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success w-100" style="font-size: 16px">RETURNED</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }

                    @if (ViewBag.Filter == "All")
                    {
                        <div class="card" style="width: 18rem; margin-left: 20px; margin-bottom:20px">
                            <img src="/image/@borrow.Book.Cover" class="card-img-top" style="width:178px; height:250px" />
                            <div class="card-body">
                                <h5 class="card-title">@borrow.Book.Title</h5>
                                <p class="card-text">@borrow.Book.Author</p>
                                <p class="card-text">Borrow date: @borrow.BorrowDate</p>
                                <p class="card-text">Return date: @(borrow.ReturnDate == null ? "Not returned" : borrow.ReturnDate)</p>

                                @if (borrow.ReturnDate == null)
                                {
                                    <a class="btn btn-danger w-100" style="font-size: 16px" asp-action="Return" asp-controller="Borrow" asp-route-id="@borrow.Id">Return</a>
                                }
                                else
                                {
                                    <a class="btn btn-success w-100" style="font-size: 16px">RETURNED</a>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p class="text-center">No records found!</p>
            }
        </div>
    </div>
</div>