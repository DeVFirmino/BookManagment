@using BooksApi.Dto

@model BooksApi.Dto.BookCreationDto

@if (TempData["SucessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SucessMessage"]
    </div>
}

@if (TempData["ErrorMesage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMesage"]
    </div>
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-custom">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h2 class="mb-0">
                            <i class="bi bi-book-half me-2 gradient-text"></i>Register New Book
                        </h2>
                        <p class="text-muted mb-0">Add a new book to your collection</p>
                    </div>

                    <form method="post" asp-action="Register" asp-controller="Book" enctype="multipart/form-data">

                        <div class="text-center mb-4">
                            <label for="ImageFile" style="cursor: pointer;">
                                <div class="position-relative d-inline-block">
                                    <img id="img" style="width:200px; height:280px; object-fit: cover; border-radius: 1rem; box-shadow: 0 10px 25px rgba(0,0,0,0.15);"
                                         src="~/image/default.png" alt="Book Cover Preview"/>
                                    <div class="position-absolute bottom-0 end-0 mb-2 me-2">
                                        <span class="badge bg-primary">
                                            <i class="bi bi-camera-fill"></i>
                                        </span>
                                    </div>
                                </div>
                            </label>
                            <p class="text-muted small mt-2" id="figcaption">Click to upload cover image</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-image me-2"></i>Book Cover
                            </label>
                            <input type="file" id="ImageFile" name="photo" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-book me-2"></i>Title
                            </label>
                            <input type="text" asp-for="Title" class="form-control" placeholder="Enter book title">
                            <span class="text-danger small" asp-validation-for="Title"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-person me-2"></i>Author
                            </label>
                            <input type="text" asp-for="Author" class="form-control" placeholder="Enter author name">
                            <span class="text-danger small" asp-validation-for="Author"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-text-paragraph me-2"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter book description"></textarea>
                            <span class="text-danger small" asp-validation-for="Description"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-calendar-event me-2"></i>Date Published
                                </label>
                                <input type="text" asp-for="DatePublished" class="form-control" placeholder="YYYY-MM-DD">
                                <span class="text-danger small" asp-validation-for="DatePublished"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-tag me-2"></i>Genre
                                </label>
                                <input type="text" asp-for="Genre" class="form-control" placeholder="Enter genre">
                                <span class="text-danger small" asp-validation-for="Genre"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-box me-2"></i>Stock Quantity
                                </label>
                                <input type="number" asp-for="Stock" class="form-control" min="1" placeholder="Enter stock quantity">
                                <span class="text-danger small" asp-validation-for="Stock"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success flex-fill">
                                <i class="bi bi-plus-circle me-2"></i>Register Book
                            </button>
                            <a class="btn btn-secondary flex-fill" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-arrow-left-circle me-2"></i>Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const inputFile = document.querySelector("#ImageFile");

    inputFile.addEventListener("change", function (e) {
        const inputTarget = e.target;
        const file = inputTarget.files[0];

        if (file) {
            const reader = new FileReader();

            reader.addEventListener("load", function (e) {
                const readerTarget = e.target;
                const img = document.querySelector("#img");
                img.src = readerTarget.result;

                const figcaption = document.querySelector("#figcaption");
                figcaption.innerHTML = file.name;
            });

            reader.readAsDataURL(file);
        }
    });
</script>
