@* 
    This Razor View is used for editing an existing Book record.  
    - Displays success or error messages from TempData.  
    - Shows the current book cover image (if available) and allows uploading a new one.  
    - Includes input fields for editing:  
        • Title  
        • Author  
        • Description  
        • Date Published  
        • Genre  
        • Stock quantity  
    - Uses hidden input to keep the Book Id.  
    - On file selection, a JavaScript script previews the uploaded image before submission.  
    - Provides buttons to confirm edits (submit form) or go back to the Book list.  

    Purpose: To allow users/admins to update book details and change its cover image.  
*@

@using BooksApi.Dto
@model BooksApi.Dto.BookEditDto


@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success text-dark" role="alert">
        @TempData["MensagemSucesso"]
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger text-dark" role="alert">
        @TempData["MensagemErro"]
    </div>
}

<div class="container mt-5">
    <form method="post" asp-action="Edit" asp-controller="Book" enctype="multipart/form-data">
        <h2>Edit Book - @Model.Title</h2>

        <input type="hidden" asp-for="Id" />

        @if (Model.Cover != null)
        {
            <div class="text-center">
                <label for="ImageFile">
                    <img src="/image/@Model.Cover" id="img" style="width:150px; height:200px" />
                </label>
            </div>

        }



        <div class="mb-1">
            <label class="form-label mt-3">Cover:</label>
            <input type="file" id="ImageFile" name="photo" class="form-control shadow-none"  />
        </div>

        <div class="mb-1">
            <label class="form-label">Title:</label>
            <input type="text" asp-for="Title" class="form-control shadow-none">
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>

        <div class="mb-1">
            <label class="form-label">Author:</label>
            <input type="text" asp-for="Author" class="form-control shadow-none">
            <span class="text-danger" asp-validation-for="Author"></span>
        </div>

        <div class="mb-1">
            <label class="form-label">Description:</label>
            <textarea asp-for="Description" class="form-control shadow-none"></textarea>
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>

        <div class="col-12 d-flex gap-1 w-100">
            <div class="mb-1 col-6">
                <label class="form-label">Date Published:</label>
                <input type="text" asp-for="DatePublished" class="form-control shadow-none">
                <span class="text-danger" asp-validation-for="DatePublished"></span>
            </div>

            <div class="mb-1 col-6">
                <label class="form-label">Genre:</label>
                <input type="text" asp-for="Genre" class="form-control shadow-none">
                <span class="text-danger" asp-validation-for="Genre"></span>
            </div>
        </div>
        <div class="col-12 d-flex gap-1 w-100">
            <div class="mb-1 col-6">
                <label class="form-label">Stock:</label>
                <input type="number" asp-for="Stock" class="form-control shadow-none" min="1">
                <span class="text-danger" asp-validation-for="Stock"></span>
            </div>

           
        </div>




        <div class="btn-box d-flex mt-3">
            <button type="submit" type="button" class="btn btn-success w-50 mx-1"><i class="bi bi-plus-circle"></i> Edit</button>
            <a type="submit" class="btn btn-info w-50" asp-controller="Book" asp-action="Index"><i class="bi bi-arrow-left-circle"></i> Back</a>
        </div>

    </form>
</div>



<script>


    const inputFile = document.querySelector("#ImageFile");

    inputFile.addEventListener("change", function (e) {
        const inputTarget = e.target;
        const file = inputTarget.files[0];

        if (file) {
            const reader = new FileReader();

            reader.addEventListener("load", function (e) {
                const readerTarget = e.target;
                const img = document.querySelector("#img");
                img.src = readerTarget.result;

                const figcaption = document.querySelector("#figcaption");
                figcaption.innerHTML = file.name;
            });

            reader.readAsDataURL(file);
        }
    }


    )
</script>
